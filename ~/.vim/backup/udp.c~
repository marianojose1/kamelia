#include <stdio.h>
#include <string.h>
#include <sys/socket.h>
#include <arpa/inet.h>
#include <unistd.h>
#include "kamelia.h"

int create_socket(int porta){
    int sock = socket(AF_INET, SOCK_DGRAM, 0);
    if(sock < 0){
        perror("[!] Erro no socket");
        return -1;
    }
    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(porta);
    if(bind(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0){
        perror("[!] Erro no bind");
        close(sock);
        return -1;
    }
    return sock;
}

int receive_msg(int sock, char* buffer, struct sockaddr_in* remetente){
    socklen_t len = sizeof(*remetente);
    return recvfrom(sock, buffer, BUFFER - 1, 0, (struct sockaddr*)remetente, &len);
}

void send_msg(int sock, char* msg, int tamanho, struct sockaddr_in* destino){
    int env = sendto(sock, msg, tamanho, 0, (struct sockaddr*)destino, sizeof(*destino));
    if(env < 0){
        perror("Erro no sendto");
    } else {
        printf("[+] Enviados %d bytes\n", env);
    }
}
